# Copy to server/.env.production, which Git ignores. Edit privately, not in chat.
# Keep server/.env untouched for local development.
DATABASE_URL=
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=1
APP_ORIGIN=
GOOGLE_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ATTACHMENT_STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
