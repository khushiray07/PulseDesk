# Copy to server/.env.production, which Git ignores. Edit privately, not in chat.
# Keep server/.env untouched for local development.
DATABASE_URL=
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=1
APP_ORIGIN=
GOOGLE_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Explicit demo-only opt-in: attachment bytes can disappear after restart/redeploy/sleep.
# No S3 credentials are required in temporary mode. Leave ATTACHMENT_STORAGE_DIR unset.
ATTACHMENT_STORAGE_DRIVER=temporary
# For durable attachments, select s3 and fill the settings below privately.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
