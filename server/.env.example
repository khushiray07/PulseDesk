DATABASE_URL="postgresql://pulsedesk:pulsedesk@127.0.0.1:55432/pulsedesk?schema=public"
TEST_DATABASE_URL="postgresql://pulsedesk:pulsedesk@127.0.0.1:55432/pulsedesk_test?schema=public"
PORT=5000
HOST=127.0.0.1
# Optional absolute directory; default is the project-local .local/attachments.
# Keep this persistent when restarting or deploying the server.
# ATTACHMENT_STORAGE_DIR=/absolute/path/to/pulsedesk-attachments

# Browser origin and callback must use the same hostname/port.
APP_ORIGIN=http://127.0.0.1:5173
GOOGLE_CALLBACK_URL=http://127.0.0.1:5173/api/auth/google/callback
# Copy these from your Google Cloud Web Application OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Set to 1 only behind exactly one trusted reverse proxy; see README production notes.
# TRUST_PROXY=1
